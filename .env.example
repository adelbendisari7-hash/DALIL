POSTGRES_PASSWORD=dalil-dev
DALIL_JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
# Numéros qui deviennent administrateurs à la première connexion
DALIL_ADMIN_PHONES=0550000000
# Modèle de langage : none | openai_compat (modèle affiné servi en local) | anthropic (comparaison)
DALIL_LLM_PROVIDER=none
DALIL_LLM_BASE_URL=
DALIL_LLM_API_KEY=
# Modèle affiné servi sur le portable : tools/llama.cpp/llama-server.exe -m ml/artifacts/dalil-qwen3-4b-instruct-2507-q4_k_m.gguf --port 8080 -c 4096
# puis DALIL_LLM_PROVIDER=openai_compat et DALIL_LLM_BASE_URL=http://127.0.0.1:8080/v1 (20 à 45 s par diagnostic sur processeur)
DALIL_LLM_TIMEOUT=300
# Recherche : keyword (par défaut) ou hybrid (vecteurs Qwen3-Embedding + reclassement bge-reranker, étape 8).
# hybrid demande torch + transformers et les fichiers de ml/artifacts (python ml/load_vectors.py) ; sans eux, retombe sur keyword.
DALIL_RETRIEVAL_MODE=keyword
